{
  "name": "craige-bikes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:setup": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/ensureSchema.ts",
    "db:setup-remote": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/setupRemote.ts",
    "media:sync": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/syncMediaToS3.ts",
    "migrate:export": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/exportContent.ts",
    "migrate:import": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/importContent.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seedCatalog.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "^0.31.7",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.59.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "type": "module"
}
